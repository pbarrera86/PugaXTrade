# Copy to .env.staging locally. Never reuse production secrets or customer data.
STAGING_DB_PASSWORD=
STAGING_PUBLIC_BASE_URL=https://staging.example.invalid
# Only Stripe test/sandbox credentials and a test-mode price/webhook.
STAGING_STRIPE_SECRET_KEY=
STAGING_STRIPE_PUBLISHABLE_KEY=
STAGING_STRIPE_PRICE_ID=
STAGING_STRIPE_WEBHOOK_SECRET=
# Use an isolated SMTP test inbox with TLS, never a production mailing list.
STAGING_SMTP_HOST=
STAGING_SMTP_PORT=587
STAGING_SMTP_USER=
STAGING_SMTP_PASS=
STAGING_SMTP_FROM=
STAGING_SMTP_ADMIN=
